# Copy to cluster.env on every machine. Paths may differ per node.
NNODES=5
GPUS_PER_NODE=8
# Set to the rank-0 machine's private address reachable from ALL nodes.
MASTER_ADDR=REPLACE_WITH_PRIVATE_IP
MASTER_PORT=29581
PLOT_ROOT=/path/to/Plot-run-m1
PYTHON_BIN="$PLOT_ROOT/.venv/bin/python"
CACHE_DIR="$PLOT_ROOT/outputs/m1_multiview_persist_s01_cache"
PERSIST_ROOT=/path/to/PERSIST
# Immutable copy of an epoch-boundary checkpoint, identical on all machines.
RESUME_CHECKPOINT="$PLOT_ROOT/checkpoints/m1_multinode_start.pt"
OUTPUT_DIR="$PLOT_ROOT/outputs/m1_flow_multinode_v1"
# Per-GPU batch. 5 * 8 * 8 = 320 global batch (NOT the old batch 64).
BATCH_PER_GPU=8
MAX_STEPS=1000000
# At least WORLD_SIZE to avoid empty per-rank reconstruction batches.
AUDIT_SAMPLES=80
FIXED_LOSS_SAMPLES=128
WORKERS=2
# Optional; actual interface names must be checked on each machine.
# export NCCL_SOCKET_IFNAME=eth0
# export GLOO_SOCKET_IFNAME=eth0
# export CUDA_VISIBLE_DEVICES=0,1,2,3,4,5,6,7
